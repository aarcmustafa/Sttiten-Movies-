APP_NAME=Sttiten Movies
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=7860
DATABASE_URL=postgresql+asyncpg://sttiten:sttiten_pass@localhost:5432/sttiten_movies
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
JWT_SECRET=change-me-to-a-very-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
TMDB_API_KEY=your_key_here
TMDB_ACCESS_TOKEN=your_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_DEFAULT_LANGUAGE=ar
SUBDL_API_KEY=your_key_here
SUBDL_BASE_URL=https://api.subdl.com/api/v1
OPENSUBTITLES_API_KEY=your_key_here
OPENSUBTITLES_BASE_URL=https://api.opensubtitles.com/api/v1
OPENSUBTITLES_USER_AGENT=SttitenMovies v1.0
